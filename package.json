{
  "name": "chat-adapter-zalo-oa",
  "version": "0.1.0",
  "description": "Zalo Official Account (OA) adapter for Chat SDK",
  "keywords": [
    "adapter",
    "bot",
    "chat",
    "chat-adapter",
    "chat-sdk",
    "messaging",
    "official-account",
    "zalo",
    "zalo-oa"
  ],
  "homepage": "https://github.com/Firef0x/chat-adapter-zalo-oa#readme",
  "bugs": {
    "url": "https://github.com/Firef0x/chat-adapter-zalo-oa/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Firef0x/chat-adapter-zalo-oa.git"
  },
  "license": "Apache-2.0",
  "author": "Firef0x <firefgx@gmail.com>",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "oxlint && oxfmt --check .",
    "format": "oxfmt .",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "clean": "rm -rf dist coverage",
    "prepublishOnly": "npm run verify"
  },
  "peerDependencies": {
    "chat": "^4.40.0"
  },
  "dependencies": {
    "@chat-adapter/shared": "^4.40.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "^4.0.0",
    "chat": "^4.40.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.27.7": true
  }
}
